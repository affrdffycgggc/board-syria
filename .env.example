# متغيرات البيئة المطلوبة لنشر المشروع

# ============================================================
# قاعدة البيانات PostgreSQL
# ============================================================
# اختر واحدة من الخيارات التالية:

# ----- خيار 1: Movestax (موصى به - PostgreSQL Serverless) -----
# بعد إنشاء قاعدة بيانات على Movestax، انسخ Transaction Pooler URL:
DATABASE_URL="postgresql://postgres.DEPLOYMENT_ID:YOUR_PASSWORD@postpool.movestax.app:6543/postgres?pgbouncer=true&connection_limit=1"

# ----- خيار 2: Neon PostgreSQL (مجاني للأبد) -----
# DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/board?sslmode=require&pgbouncer=true&connection_limit=1"

# ----- خيار 3: Supabase -----
# DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"

# ----- خيار 4: PostgreSQL محلي للتطوير -----
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/board"

# ============================================================
# مصادقة الإدارة
# ============================================================

# كلمة مرور الإدارة المشفرة بـ bcrypt (الافتراضية: board-admin-2026)
ADMIN_PASSWORD_HASH=$2b$10$M7C51jnRh6HyPEf8Tc1FiuXzfzT760N4DRbvSZY4kjbv3/k89JFCi

# مفتاح JWT السري (32+ حرف، يجب تغييره للإنتاج)
JWT_SECRET=SyrianBoard_2026_Production_Secret_Min_32_Chars_Long_String_DoNotShare
